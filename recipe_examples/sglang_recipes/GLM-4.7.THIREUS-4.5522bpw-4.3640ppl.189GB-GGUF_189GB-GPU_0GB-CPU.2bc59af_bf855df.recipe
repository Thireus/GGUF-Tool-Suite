^blk\.([0-9]|[1-8][0-9]|9[0-2])\.attn_v\.weight$=sgl_nvfp4

## Dense Feed-Forward Network weights — qbits: 4 
^blk\.[0-2]\.ffn_down\.weight$=sgl_nvfp4
^blk\.[0-2]\.ffn_up\.weight$=sgl_nvfp4
^blk\.[0-2]\.ffn_gate\.weight$=sgl_nvfp4

## NextN tensors — qbits: 4 
^blk\.92\.nextn\.eh_proj\.weight$=sgl_nvfp4
^blk\.92\.nextn\.embed_tokens\.weight$=sgl_nvfp4
^blk\.92\.nextn\.shared_head_head\.weight$=sgl_nvfp4

## MoE Gating & Routing — qbits: 16 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_gate_inp\.weight$=sgl_bf16
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.exp_probs_b\.bias$=sgl_bf16

## GPU-loaded - MoE Shared Experts Feed-Forward Network - ffn_*_shexp
# ffn_down_shexp — down-projection (shared experts) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_down_shexp\.weight$=sgl_nvfp4

# ffn_up_shexp — up-projection (shared experts) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_up_shexp\.weight$=sgl_nvfp4

# ffn_gate_shexp — gating network (shared experts) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_gate_shexp\.weight$=sgl_nvfp4

## CPU-friendly - MoE Per-expert Feed-Forward Network - ffn_*_exps
# ffn_down_exps — down-projection (per-expert) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_down_exps\.weight$=sgl_nvfp4

# ffn_up_exps — up-projection (per-expert) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_up_exps\.weight$=sgl_nvfp4

# ffn_gate_exps — gating network (per-expert) — qbits: 4 
^blk\.([3-9]|[1-8][0-9]|9[0-2])\.ffn_gate_exps\.weight$=sgl_nvfp4

